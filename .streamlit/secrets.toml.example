# Used only when deploying to Streamlit Community Cloud (or anywhere that reads
# st.secrets). Copy this file to ".streamlit/secrets.toml" and fill in real
# values — that file is git-ignored and must be set directly in the Streamlit
# Cloud app settings (Settings > Secrets) for a deployed app, since the file
# itself is never pushed to the repo.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-api-key"
