# Copy this file to ".env" (same folder) and fill in your real Supabase values.
# Never commit the real ".env" file — it's already excluded via .gitignore.

# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the "anon" public key for the Streamlit app (read-only via RLS policies
# in sql/schema.sql). Use the "service_role" key only for the one-time
# scripts/load_csv_to_supabase.py loader (never ship the service_role key
# to a deployed Streamlit app).
SUPABASE_KEY=your-anon-public-api-key
